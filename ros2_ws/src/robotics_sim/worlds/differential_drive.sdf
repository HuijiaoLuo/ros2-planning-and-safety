<?xml version="1.0"?>
<sdf version="1.9">
  <world name="robotics_world">
    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Keep the world self-contained instead of depending on Gazebo model URIs. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="obstacle_box">
      <static>true</static>
      <pose>1.0 0 0.25 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 1.00 0.50</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 1.00 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.20 0.10 1</ambient>
            <diffuse>0.75 0.20 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual-only goal marker at the planner goal (2.0, 0.0). -->
    <model name="goal_marker">
      <static>true</static>
      <pose>2.0 0 0.01 0 0 0</pose>
      <link name="goal_link">
        <visual name="goal_disk">
          <!-- Keep the marker visible in the GUI, but outside the LiDAR mask. -->
          <visibility_flags>2</visibility_flags>
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.10 0.85 0.20 1</ambient>
            <diffuse>0.10 0.85 0.20 1</diffuse>
            <emissive>0.02 0.20 0.04 1</emissive>
          </material>
        </visual>
        <visual name="goal_pole">
          <visibility_flags>2</visibility_flags>
          <pose>0 0 0.50 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.10 0.85 0.20 1</ambient>
            <diffuse>0.10 0.85 0.20 1</diffuse>
          </material>
        </visual>
        <visual name="goal_flag">
          <visibility_flags>2</visibility_flags>
          <pose>0.10 0 0.88 0 0 0</pose>
          <geometry>
            <box>
              <size>0.20 0.02 0.14</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.85 0.20 1</ambient>
            <diffuse>0.10 0.85 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="diff_drive_robot">
      <pose>0 0 0 0 0 0</pose>

      <link name="base_link">
        <pose>0 0 0.20 0 0 0</pose>
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.12</ixx>
            <iyy>0.25</iyy>
            <izz>0.30</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.50 0.36 0.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.50 0.36 0.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.35 0.80 1</ambient>
            <diffuse>0.15 0.35 0.80 1</diffuse>
          </material>
        </visual>

        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.18 0 0 0</pose>
          <topic>/scan</topic>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265359</min_angle>
                <max_angle>3.14159265359</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.12</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
            <!-- Detect physical scene visuals (flag 1), not the GUI-only goal marker (flag 2). -->
            <visibility_mask>1</visibility_mask>
          </ray>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>

        <!-- Publish physical contacts for evaluation; this collision covers
             the robot body without counting normal wheel-ground contact. -->
        <sensor name="contact_sensor" type="contact">
          <topic>/collision/contacts</topic>
          <update_rate>30</update_rate>
          <always_on>true</always_on>
          <contact>
            <collision>base_collision</collision>
          </contact>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0 0.22 0.10 1.57079632679 0 0</pose>
        <inertial>
          <mass>0.30</mass>
          <inertia>
            <ixx>0.0015</ixx>
            <iyy>0.0015</iyy>
            <izz>0.0015</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.22 0.10 1.57079632679 0 0</pose>
        <inertial>
          <mass>0.30</mass>
          <inertia>
            <ixx>0.0015</ixx>
            <iyy>0.0015</iyy>
            <izz>0.0015</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
        </visual>
      </link>

      <link name="front_caster">
        <pose>0.18 0 0.06 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.06</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.06</radius>
            </sphere>
          </geometry>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <pose relative_to="left_wheel" />
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <pose relative_to="right_wheel" />
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <joint name="front_caster_joint" type="fixed">
        <parent>base_link</parent>
        <child>front_caster</child>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.44</wheel_separation>
        <wheel_radius>0.10</wheel_radius>
        <!-- Bound actuator acceleration to keep the ideal robot physically
             stable when commands change direction or start moving. -->
        <max_linear_acceleration>0.5</max_linear_acceleration>
        <min_linear_acceleration>-0.5</min_linear_acceleration>
        <max_angular_acceleration>1.0</max_angular_acceleration>
        <min_angular_acceleration>-1.0</min_angular_acceleration>
        <max_linear_velocity>0.20</max_linear_velocity>
        <min_linear_velocity>-0.20</min_linear_velocity>
        <max_angular_velocity>1.20</max_angular_velocity>
        <min_angular_velocity>-1.20</min_angular_velocity>
        <topic>/cmd_vel</topic>
        <!-- Preserve wheel odometry separately from simulator ground truth. -->
        <odom_topic>/wheel_odom</odom_topic>
        <tf_topic>/tf_wheel</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>

      <!--
        Ground-truth odometry for the ideal-navigation MVP. This reads the
        simulated model pose directly; wheel odometry remains available on
        /wheel_odom for later slip and localization experiments.
      -->
      <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/odom</odom_topic>
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <tf_topic>/tf_ground_truth</tf_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </model>
  </world>
</sdf>
